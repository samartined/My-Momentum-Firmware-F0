{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(./fbt:*)",
      "Bash(./fbt fap_*:*)",
      "Bash(./fbt format)",
      "Bash(./fbt format_python)",
      "Bash(./fbt firmware_all)",
      "Bash(./fbt firmware_apps)",
      "Bash(./fbt firmware_extapps)",
      "Bash(./fbt updater_package)",
      "Bash(./fbt updater_minpackage)",
      "Bash(./fbt cli)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b *)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git stash list)",
      "Bash(git stash show:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(mkdir -p:*)",
      "Bash(./.claude/scripts/check-irreversibility.sh:*)",
      "Bash(./.claude/scripts/setup.sh)",
      "Bash(./.claude/scripts/bootstrap.sh)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/design/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/scripts/**)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/state/**)",
      "Edit(/.githooks/**)",
      "Bash(./fbt flash:*)",
      "Bash(./fbt flash_usb:*)",
      "Bash(./fbt flash_blackmagic:*)",
      "Bash(./fbt jflash:*)",
      "Bash(./fbt openocd:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --merge:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -xfd:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/bootstrap.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-git-checkout.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "council-member",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/update-agent-counter.sh council-member"
          }
        ]
      },
      {
        "matcher": "agent-architect",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/update-agent-counter.sh agent-architect"
          }
        ]
      }
    ]
  }
}
